class Solution {
    public int coinChange(int[] coins, int amount) {

        if(amount<0) return 0;

        int[] minVal=new int[amount+1];

        for(int i=1;i<=amount;i++){
            minVal[i]=Integer.MAX_VALUE;

            for(int coin:coins){
                if(coin<=i && minVal[i-coin]!=Integer.MAX_VALUE){
                    minVal[i]=Math.min(minVal[i],1+minVal[i-coin]);
                }
            }
        }
        if(minVal[amount]==Integer.MAX_VALUE)return -1;

        return minVal[amount];    
    }
}
