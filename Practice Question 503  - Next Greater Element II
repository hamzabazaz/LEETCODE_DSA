class Solution {
    public int[] nextGreaterElements(int[] nums) {
        int [] res=new int[nums.length];
        Arrays.fill(res,-1);
        int n=nums.length;
        Deque<Integer> stack= new ArrayDeque<>();
        for(int i=0;i<2*n;i++){
            int index=i%n;
            while(!stack.isEmpty() && nums[stack.peek()]<nums[index]){
                int st=stack.pop();
                res[st]=nums[index];
            }
            if(i<n){
                stack.push(index);
            }
        }
       return res; 
        }
       
    }
     

